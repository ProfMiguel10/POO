package classes;

public abstract class Usuario {
	String nome;
	String email;

	public Usuario(String nome, String email) {
		this.nome = nome;
		this.email = email;
	}

	public void apresentar() {
		System.out.println("Nome: " + nome);
		System.out.println("E-mail: " + email);
	}

	public abstract void exibirPerfil();
}
