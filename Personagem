package aplicacao;

abstract class Personagem {
	protected String nome;
	protected int vida;

	public Personagem(String nome, int vida) {
		this.nome = nome;
		this.vida = vida;
	}

	public abstract void atacar();

	public void receberDano(int dano) {
		vida -= dano;
		if (vida < 0) {
			vida = 0;
		}
	}

	public boolean estaVivo() {
		return vida > 0;
	}
}
