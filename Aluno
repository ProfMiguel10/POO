package aluno;

public class Aluno {

    private String nome;
    private int matricula;

    public Aluno(String nome, int matricula) {
        this.nome = nome;
        this.matricula = matricula;
    }

    public void estudar() {
        System.out.println(nome + " está estudando.");
    }

    @Override
    public String toString() {
        return "Aluno: " + nome + " | Matrícula: " + matricula;
    }
}



